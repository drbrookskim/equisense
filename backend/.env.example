# EquiSense 백엔드 환경 변수 템플릿
# 이 파일을 .env로 복사하고 실제 값을 채워 로컬 개발에 사용합니다.
# .env는 절대 Git에 커밋하지 않습니다 (.gitignore 참조).

# Upstash Redis (Serverless Redis Cache Layer)
UPSTASH_REDIS_URL=rediss://:your-token@your-endpoint.upstash.io:6379

# Financial Modeling Prep API
FMP_API_KEY=your-fmp-api-key

# Neon PostgreSQL (Serverless PostgreSQL — 반드시 PgBouncer 풀링 URL 사용)
# 포트 6432 (PgBouncer) 사용. 5432 직접 연결 금지.
NEON_DATABASE_URL=postgresql://user:password@your-host.neon.tech:6432/equisense?sslmode=require
